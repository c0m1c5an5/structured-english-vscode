{
  "name": "structured-english-vscode",
  "publisher": "c0m1c5an5",
  "displayName": "Structured English",
  "description": "Syntax highlighting, error checking and auto-indent for Structured English pseudocode",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "license": "MIT",
  "author": {
    "name": "Maksym Kondratenko",
    "email": "m.kondratenko.ua@gmail.com",
    "url": "https://github.com/c0m1c5an5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/c0m1c5an5/structured-english-vscode"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:structured-english"
  ],
  "contributes": {
    "languages": [
      {
        "id": "structured-english",
        "aliases": [
          "Structured English",
          "structured-english"
        ],
        "extensions": [
          ".se"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "structured-english",
        "scopeName": "source.structured-english",
        "path": "./syntaxes/structured-english.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src && prettier --check .",
    "test": "vscode-test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.4.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
