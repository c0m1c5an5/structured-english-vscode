{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured English",
  "scopeName": "source.structured-english",
  "patterns": [
    {
      "comment": "A line starting with #, * or //",
      "match": "^\\s*((?:#|\\*|//).*)$",
      "captures": {
        "1": {
          "name": "comment.line.structured-english"
        }
      }
    },
    {
      "comment": "A keyword in capitals at the start of a line, then its argument",
      "match": "^\\s*(ELSE\\s*IF|END\\s*WHILE|OTHERWISE|END\\s*CASE|END\\s*FOR|END\\s*IF|REPEAT|WHILE|UNTIL|CASE|ELSE(?!\\s*(?i:if)(?:\\s|$))|WHEN|FOR|IF)(?=\\s|$)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.structured-english"
        },
        "2": {
          "name": "variable.parameter.structured-english",
          "patterns": [
            {
              "include": "#inline"
            }
          ]
        }
      }
    },
    {
      "comment": "Any other line is a step",
      "match": "^\\s*(.+)$",
      "captures": {
        "1": {
          "name": "entity.name.function.structured-english",
          "patterns": [
            {
              "include": "#inline"
            }
          ]
        }
      }
    }
  ],
  "repository": {
    "inline": {
      "patterns": [
        {
          "comment": "`code`, \"quoted text\", URLs and paths such as /dev/kvm and ~/.vimrc",
          "match": "`[^`]*`|\"[^\"]*\"|https?://[^\\s\"`<>]*[^\\s\"`<>.,;:!?)]|(?<![A-Za-z0-9_/.~])(?:~|\\.{1,2})?/[A-Za-z0-9_.~@%+=:/-]*[A-Za-z0-9_~@%+=/-]",
          "name": "string.other.literal.structured-english"
        },
        {
          "comment": "Operators: whole words in capitals",
          "match": "(?<![A-Za-z0-9_])(?:AND|OR|NOT|EACH|IN|THEN|DO)(?![A-Za-z0-9_])",
          "name": "keyword.operator.wordlike.structured-english"
        }
      ]
    }
  }
}
